# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Secrets & local environment
.env
.env.*
!.env.example

# Databases
*.db
*.sqlite3
*.db-shm
*.db-wal

# Chroma / Vector DB
chroma/
chroma_db/
vector_store/
embeddings/

# Logs
logs/
*.log
metrics/

